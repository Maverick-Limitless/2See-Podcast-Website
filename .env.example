# 2See Podcast — environment configuration template
#
# Copy this file to .env and replace every placeholder with a value you control.
# NEVER commit the real .env file. It is listed in .gitignore.
# Every placeholder below is a placeholder. No real secret is present in this file.

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------

# "production" enables secure cookies, HSTS and strict caching behaviour.
# Any other value (including "development") is treated as development mode.
NODE_ENV=production

# Port the standalone server listens on.
PORT=3000

# Address the server binds to. Use 127.0.0.1 behind a local reverse proxy,
# or 0.0.0.0 when the platform provides the network boundary.
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Public origin
# ---------------------------------------------------------------------------

# The canonical public origin, used for absolute URLs in Open Graph tags,
# the sitemap and robots.txt. No trailing slash. Leave empty to render
# protocol-relative links instead of inventing a domain.
PUBLIC_ORIGIN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Absolute or relative path to the SQLite database file. The directory is
# created automatically. Keep it outside the web root and out of Git.
DATABASE_PATH=./data/2see.db

# Optional: directory for local, timestamped SQLite backup copies.
DATABASE_BACKUP_DIR=./data/backups

# ---------------------------------------------------------------------------
# Session and CSRF secrets
# ---------------------------------------------------------------------------

# HMAC key used to sign session tokens. MUST be unique per deployment and at
# least 32 bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-48-byte-random-base64-secret

# Separate HMAC key for CSRF tokens. If empty, a key is derived from
# SESSION_SECRET and a purpose label. Generating a distinct key is preferred.
CSRF_SECRET=

# Session lifetime in seconds. Default: 43200 (12 hours).
SESSION_TTL_SECONDS=43200

# ---------------------------------------------------------------------------
# First administrator
# ---------------------------------------------------------------------------

# Exactly one administrative account exists. Username is fixed to tosi-podcast.
#
# Option A (preferred, no secret in any file):
#   Run `npm run init:admin`. A cryptographically secure random password is
#   generated, displayed once, hashed with scrypt and stored. Nothing is written
#   to disk or committed to Git.
#
# Option B: set the two values below, run `npm run init:admin`, then remove them
#   from the environment file again. The password is hashed immediately and the
#   plaintext value is never stored.
#
# Both options refuse to run once an administrator already exists.
ADMIN_SETUP_PASSWORD=
ADMIN_DISPLAY_NAME=Tosi Podcast

# One-time bootstrap token for the browser setup route at /setup.
# Only honoured while no administrator exists. Generate with: openssl rand -hex 32
# Leave empty to disable the browser setup route entirely.
ADMIN_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# YouTube access
# ---------------------------------------------------------------------------

# YouTube Data API v3 key. Optional. Without it, episode management is still
# fully functional through manual entry, and a limited public-feed fallback
# reads the channel's most recent uploads.
# The key is never sent to the browser and never written into any API response.
YOUTUBE_API_KEY=

# The channel to synchronise from. Accepts the handle or the channel ID.
YOUTUBE_CHANNEL_HANDLE=@2See.Podcast
YOUTUBE_CHANNEL_ID=UCIV4JGPrV3bHNBGYPLnfqTA

# Maximum number of videos fetched per scheduled run. YouTube Data API quota
# units are consumed per request, so keep this modest.
YOUTUBE_SYNC_MAX_RESULTS=25

# ---------------------------------------------------------------------------
# Request handling
# ---------------------------------------------------------------------------

# Failed-admin-login throttle: window length in seconds and maximum attempts
# per window per client.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8

# Failures required across the whole deployment before a generic error page is
# returned for admin routes. Keeps a single bad session from causing noise.
MAX_REQUEST_SIZE_BYTES=262144
